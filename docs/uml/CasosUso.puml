@startuml CasosUso_SIGAC
left to right direction
skinparam packageStyle rectangle

actor "Recepcionista" as Recepcion
actor "Médico" as Medico
actor "Administrador" as Admin
actor "Temporizador" as Reloj
actor "Paciente" as Paciente

rectangle "SIGAC — Sistema de Gestión de Atención Clínica" {

  ' --- Comunes ---
  usecase "Autenticar con token" as UC_Auth
  usecase "Registrar en la bitácora" as UC_Bitacora
  usecase "Generar token" as UC_Token
  usecase "Iniciar sesión" as UC_Sesion

  ' --- Recepción ---
  usecase "Registrar solicitud de cita" as UC_Solicitud
  usecase "Indicar preferencias\n(franja, hora, especialidad, médico)" as UC_Pref
  usecase "Cancelar cita" as UC_Cancelar
  usecase "Reasignar cupo liberado" as UC_Reasignar
  usecase "Consultar citas del día" as UC_Citas
  usecase "Consultar lista de espera" as UC_ListaEspera

  ' --- Médico ---
  usecase "Consultar agenda del día" as UC_Agenda
  usecase "Cerrar cita" as UC_Cerrar
  usecase "Registrar nota clínica" as UC_Nota
  usecase "Consultar historial clínico" as UC_Historial

  ' --- Administración ---
  usecase "Consultar personas" as UC_Personas
  usecase "Agregar médico o recepcionista" as UC_Agregar
  usecase "Desactivar persona" as UC_Desactivar
  usecase "Dar de baja a una persona" as UC_Baja
  usecase "Reactivar persona" as UC_Reactivar
  usecase "Reasignar citas del médico" as UC_ReasignarMed

  ' --- Procesos automáticos ---
  usecase "Asignar cita" as UC_Asignar
  usecase "Ingresar a lista de espera" as UC_Espera
  usecase "Notificar al paciente" as UC_Notificar
  usecase "Abrir expediente" as UC_Expediente
  usecase "Generar reporte semanal" as UC_Reporte
  usecase "Registrar error y alertar" as UC_Error
}

' --- Actores y casos de uso ---
Recepcion --> UC_Sesion
Recepcion --> UC_Solicitud
Recepcion --> UC_Cancelar
Recepcion --> UC_Citas
Recepcion --> UC_ListaEspera

Medico --> UC_Sesion
Medico --> UC_Agenda
Medico --> UC_Cerrar
Medico --> UC_Nota
Medico --> UC_Historial

Admin --> UC_Sesion
Admin --> UC_Personas
Admin --> UC_Agregar
Admin --> UC_Desactivar
Admin --> UC_Baja
Admin --> UC_Reactivar

Reloj --> UC_Asignar
Reloj --> UC_Notificar
Reloj --> UC_Reporte

UC_Notificar --> Paciente
UC_Reporte --> Admin
UC_Error --> Admin

' --- Include: obligatorios ---
UC_Sesion ..> UC_Auth : <<include>>
UC_Solicitud ..> UC_Auth : <<include>>
UC_Cancelar ..> UC_Auth : <<include>>
UC_Citas ..> UC_Auth : <<include>>
UC_ListaEspera ..> UC_Auth : <<include>>
UC_Agenda ..> UC_Auth : <<include>>
UC_Cerrar ..> UC_Auth : <<include>>
UC_Nota ..> UC_Auth : <<include>>
UC_Historial ..> UC_Auth : <<include>>
UC_Personas ..> UC_Auth : <<include>>
UC_Agregar ..> UC_Auth : <<include>>
UC_Desactivar ..> UC_Auth : <<include>>
UC_Baja ..> UC_Auth : <<include>>
UC_Reactivar ..> UC_Auth : <<include>>

UC_Sesion ..> UC_Bitacora : <<include>>
UC_Solicitud ..> UC_Bitacora : <<include>>
UC_Nota ..> UC_Bitacora : <<include>>
UC_Historial ..> UC_Bitacora : <<include>>

UC_Agregar ..> UC_Token : <<include>>
UC_Notificar ..> UC_Expediente : <<include>>

' --- Extend: opcionales ---
UC_Pref ..> UC_Solicitud : <<extend>>
UC_Reasignar ..> UC_Cancelar : <<extend>>
UC_Espera ..> UC_Asignar : <<extend>>
UC_ReasignarMed ..> UC_Desactivar : <<extend>>
UC_ReasignarMed ..> UC_Baja : <<extend>>
UC_Token ..> UC_Reactivar : <<extend>>

note right of UC_Sesion
  La usa la aplicación web para saber
  a qué pantallas enviar a cada persona.
  Cada inicio queda en la bitácora.
end note

note right of UC_Agenda
  Solo las citas del médico que llama:
  el médico sale de su token.
end note

note right of UC_Historial
  Cada consulta queda en la
  bitácora, aunque el historial
  esté vacío.
end note

note right of UC_ReasignarMed
  Solo cuando la persona es un médico
  con citas futuras: pasan a otro de su
  especialidad o de Medicina General;
  si nadie puede atenderlas, se cancelan.
end note

note right of UC_Reasignar
  Solo si hay alguien en lista de
  espera para esa fecha.
end note

note right of UC_Error
  Lo dispara WF-00 ante un fallo
  no previsto de cualquier flujo.
end note
@enduml
