@startuml Clases_SIGAC
skinparam classAttributeIconSize 0

class UsuarioApi {
  - id: Integer
  - rol: String
  - tokenHash: String
  - activo: Boolean
  + validarToken(hash: String): Boolean
  + tieneRol(rol: String): Boolean
  + generarToken(): String
  + desactivar(): void
}

class Paciente {
  - id: Integer
  - dpiCifrado: String
  - dpiHuella: String
  - nombre: String
  - apellido: String
  - telefonoCifrado: String
  - fechaNacimiento: Date
  - correo: String
  - activo: Boolean
  - bajaEn: DateTime
  + cifrar(dpi: String, telefono: String): void
  + registrarOReutilizar(huella: String): Paciente
  + enmascararDPI(): String
  + desactivar(): void
  + darBaja(): void
  + reactivar(): void
}

class Medico {
  - id: Integer
  - nombre: String
  - especialidad: String
  - colegiado: String
  - activo: Boolean
  - bajaEn: DateTime
  + leerActivos(): List<Medico>
  + estaActivo(): Boolean
  + desactivar(): void
  + darBaja(): void
  + reactivar(): void
}

class Recepcionista {
  - id: Integer
  - nombre: String
  - activo: Boolean
  - bajaEn: DateTime
  - creadoEn: DateTime
  + desactivar(): void
  + darBaja(): void
  + reactivar(): void
}

class Disponibilidad {
  - id: Integer
  - diaSemana: Integer
  - horaInicio: Time
  - horaFin: Time
  - cupos: Integer
  + buscarCupo(fecha: Date, franja: String): Integer
}

class SolicitudCita {
  - id: Integer
  - tipoConsulta: String
  - motivo: String
  - prioridad: Integer
  - estado: String
  - fechaPreferida: Date
  - franjaPreferida: String
  - horaSolicitada: Time
  - especialidadSolicitada: String
  + validarDatos(catalogo: List<Medico>): Boolean
  + registrar(): void
  + clasificar(): void
  + asignarPrioridad(): void
  + cambiarEstado(estado: String): void
}

class Cita {
  - id: Integer
  - fechaHora: DateTime
  - estado: String
  - notificada: Boolean
  + crear(): void
  + horasOcupadas(fecha: Date): List<Time>
  + cancelar(): void
  + cerrar(resultado: String): void
  + reasignar(medico: Medico): void
  + marcarNotificada(): void
}

class Expediente {
  - id: Integer
  - diagnosticoCifrado: String
  - indicacionesCifrado: String
  - creadoPor: String
  + abrir(): void
}

class NotaClinica {
  - id: Integer
  - diagnosticoCifrado: String
  - indicacionesCifrado: String
  - creadoEn: DateTime
  + registrar(): void
  + descifrar(): String
}

class ListaEspera {
  - id: Integer
  - prioridad: Integer
  - posicion: Integer
  - atendida: Boolean
  - notificada: Boolean
  - creadoEn: DateTime
  + encolar(): void
  + siguienteEnEspera(): SolicitudCita
  + marcarNotificada(): void
}

class BitacoraAuditoria {
  - id: Integer
  - tablaAfectada: String
  - idRegistro: Integer
  - accion: String
  - rol: String
  - datosEnmascarados: String
  - hashAnterior: String
  - hashActual: String
  + encadenar(hashAnterior: String): void
  + verificarCadena(): Boolean
}

class LogErrores {
  - id: Integer
  - workflow: String
  - nodo: String
  - mensaje: String
  - payloadEnmascarado: String
  - severidad: String
  - creadoEn: DateTime
  + registrar(mensaje: String): void
}

Medico "1" o-- "0..*" Disponibilidad : define >
Paciente "1" -- "0..*" SolicitudCita : realiza >
SolicitudCita "1" -- "0..1" Cita : origina >
Medico "1" -- "0..*" Cita : atiende >
Paciente "1" -- "0..*" Cita : recibe >
Cita "1" -- "0..1" Expediente : genera >
Paciente "1" -- "0..*" Expediente : posee >
SolicitudCita "1" -- "0..1" ListaEspera : ingresa a >
Medico "0..1" -- "0..*" SolicitudCita : es solicitado en >

Expediente "1" o-- "0..*" NotaClinica : contiene >
Medico "1" -- "0..*" NotaClinica : firma >
Cita "1" -- "0..*" NotaClinica : se escribe sobre <

UsuarioApi "0..*" -- "0..1" Medico : identifica >
UsuarioApi "0..*" -- "0..1" Recepcionista : identifica >

UsuarioApi "1" ..> "0..*" SolicitudCita : autoriza >
SolicitudCita "1" ..> "0..*" BitacoraAuditoria : registra >
Cita "1" ..> "0..*" BitacoraAuditoria : registra >
NotaClinica "1" ..> "0..*" BitacoraAuditoria : registra escritura y lectura >

note bottom of Cita
  Un Médico no puede tener dos Citas vigentes en la
  misma fecha y hora: lo impide un índice único que
  excluye las canceladas. Al asignar, además, ninguna
  cita del médico puede empezar a menos de 30 minutos.
end note

note bottom of Paciente
  El DPI se guarda cifrado. Como el cifrado usa IV
  aleatorio, se guarda además dpiHuella (SHA-256 fijo)
  para poder buscar y evitar duplicados sin descifrar.
end note

note bottom of BitacoraAuditoria
  Cada registro guarda el hash del anterior.
  Si alguien altera una fila, la cadena se rompe
  y verificarCadena() lo detecta.
end note

note right of NotaClinica
  Inmutable: solo se inserta, nunca se
  modifica ni se borra. El médico que la
  firma sale de su token, no de la petición.
end note

note right of UsuarioApi
  Una persona puede tener varios tokens en su
  historial, pero solo uno activo a la vez.
end note

note top of Recepcionista
  Paciente, Medico y Recepcionista tienen tres
  estados: activo, inactivo (reversible) y baja
  (bajaEn con fecha, definitiva). Nunca se borran.
end note

note bottom of LogErrores
  Lo escribe WF-00 ante un fallo no previsto
  de cualquier flujo, no una clase en particular.
end note
@enduml
