# SIGAC — Plantilla de variables de entorno
# Este archivo SI se versiona. Copiarlo como .env y completar los valores.
# El archivo .env NUNCA se sube al repositorio.

# --- Base de datos ---
POSTGRES_USER=<completar>
POSTGRES_DB=<completar>

# --- Correo local (MailHog) — notificaciones al paciente ---
SMTP_HOST=<completar>
SMTP_PORT=<completar>

# --- Correo saliente real (Gmail) — alertas y reportes al administrador ---
# La contrasena de aplicacion no va aqui: se configura en la credencial
# SIGAC Gmail dentro de n8n, que la cifra con N8N_ENCRYPTION_KEY.
SIGAC_CORREO_ADMIN=<completar>
SIGAC_GMAIL_USUARIO=<completar>
SIGAC_GMAIL_HOST=smtp.gmail.com
SIGAC_GMAIL_PORT=465

# --- Secretos ---
POSTGRES_PASSWORD=<completar>
N8N_ENCRYPTION_KEY=<completar>
SIGAC_CLAVE_CIFRADO=<completar>
SIGAC_TOKEN_RECEPCION=<completar>
SIGAC_TOKEN_MEDICO=<completar>
SIGAC_TOKEN_ADMIN=<completar>
SIGAC_TOKEN_MEDICO_1=<completar>
SIGAC_TOKEN_MEDICO_2=<completar>
SIGAC_TOKEN_MEDICO_3=<completar>
SIGAC_TOKEN_MEDICO_4=<completar>
SIGAC_TOKEN_MEDICO_5=<completar>
