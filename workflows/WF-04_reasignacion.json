        "jsCode": "// token ausente, invalido, o rol sin permiso para cancelar.\n// mensaje generico a proposito.\nreturn [{\n  json: {\n    codigo: 401,\n    estado: 'rechazado',\n    mensaje: 'Token ausente o invalido, o rol sin autorizacion'\n  }\n}];"
