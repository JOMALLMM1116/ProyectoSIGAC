    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with nueva as (\n  insert into cita (id_solicitud, id_paciente, id_medico, fecha_hora)\n  values ($1::int, $2::int, $3::int, $4::timestamptz)\n  returning id, id_solicitud\n),\nespera as (\n  update lista_espera\n  set atendida = true\n  where id = $5::int\n  returning id\n)\nupdate solicitud_cita\nset estado = 'asignada'\nfrom nueva\nwhere solicitud_cita.id = nueva.id_solicitud\nreturning nueva.id as id_cita_nueva, solicitud_cita.id as id_solicitud, solicitud_cita.estado;",
        "options": {
