      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select c.id as id_cita,\n       c.id_paciente,\n       c.fecha_hora,\n       p.nombre,\n       p.apellido,\n       p.correo,\n       m.nombre as medico,\n       m.especialidad\nfrom cita c\njoin paciente p on p.id = c.id_paciente\njoin medico m on m.id = c.id_medico\nwhere c.notificada = false\n  and c.estado = 'confirmada'\nlimit 10;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "151bf1f4-12b8-4eb9-97cb-bdb23faa32c5",
      "name": "Lee citas sin notificar",
      "alwaysOutputData": false,
      "credentials": {
        "postgres": {
          "id": "SboKk4ZMcKtMLxBt",
          "name": "SIGAC PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "no-responder@sigac.local",
        "toEmail": "={{ $json.correo }}",
        "subject": "=Cita confirmada — {{ DateTime.fromISO($json.fecha_hora).setZone('America/Guatemala').toFormat(\"dd/MM/yyyy 'a las' HH:mm\") }}\n",
        "html": "=<p>Estimado(a) {{ $json.nombre }} {{ $json.apellido }},</p>\n<p>Su cita ha sido confirmada con los siguientes datos:</p>\n<ul>\n  <li><b>Fecha y hora:</b> {{ DateTime.fromISO($json.fecha_hora).setZone('America/Guatemala').toFormat(\"dd/MM/yyyy 'a las' HH:mm\") }}</li>\n  <li><b>Medico:</b> {{ $json.medico }}</li>\n  <li><b>Especialidad:</b> {{ $json.especialidad }}</li>\n</ul>\n<p>Presentese 15 minutos antes. Si no puede asistir, comuniquese con recepcion.</p>\n<p>SIGAC - Sistema de Gestion de Atencion Clinica</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        448,
        0
      ],
      "id": "9ad734e7-fff4-4476-81a4-7ce14194f31e",
      "name": "Notifica al paciente",
      "webhookId": "05491043-6995-4ccd-9671-f1c988f75e6c",
      "credentials": {
        "smtp": {
