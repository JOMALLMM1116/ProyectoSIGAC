          "name": "SIGAC MailHog"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with marcada as (\n  update cita set notificada = true\n  where id = $1::int\n  returning id, id_paciente\n)\ninsert into expediente (id_paciente, id_cita, creado_por)\nselect m.id_paciente, m.id, 'sistema'\nfrom marcada m\non conflict (id_cita) do nothing\nreturning id as id_expediente, id_cita;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ $('Lee citas sin notificar').item.json.id_cita }}"
        }
      },
