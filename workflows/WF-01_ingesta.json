    },
    {
      "parameters": {
        "jsCode": "// lee el token de la cabecera y calcula su sha-256.\n// nunca se compara el token en claro contra la base:\n// se compara hash contra hash.\nconst crypto = require('crypto');\n\nconst cabeceras = $input.first().json.headers || {};\nconst cuerpo    = $input.first().json.body    || {};\n\nconst token = cabeceras['x-sigac-token'] || '';\n\nconst tokenHash = token\n  ? crypto.createHash('sha256').update(token).digest('hex')\n  : '';\n\nreturn [{\n  json: {\n    token_hash: tokenHash,\n    tiene_token: token.length > 0,\n    datos: cuerpo\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1040,
        -192
      ],
      "id": "f994bc04-7d71-41cc-b6a5-7d05cbb86480",
      "name": "Hash del token"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": "={{$json.codigo || 200}}"
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
