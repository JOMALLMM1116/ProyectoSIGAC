      "name": "¿Rol autorizado?"
    },
    {
      "parameters": {
        "jsCode": "// token ausente, invalido, o rol sin permiso para cerrar citas.\n// el cierre lo hace el medico que atendio, no recepcion.\nreturn [{\n  json: {\n    codigo: 401,\n    estado: 'rechazado',\n    mensaje: 'Token ausente o invalido, o rol sin autorizacion'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        192
      ],
      "id": "916dbdf2-dc83-49f8-8b76-7403395e845f",
      "name": "Rechazo 401"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update cita\nset estado = $1\nwhere id = $2::int\n  and estado = 'confirmada'\n  and fecha_hora <= now()\nreturning id as id_cita, id_medico, estado, fecha_hora;",
        "options": {
          "queryReplacement": "={{ $('Hash del token').first().json.resultado }}, {{ $('Hash del token').first().json.id_cita }}"
        }
      },
