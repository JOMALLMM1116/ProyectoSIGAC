      "name": "Webhook",
      "webhookId": "78d56a8a-f120-49a0-a579-3e48cd155e6d"
    },
    {
      "parameters": {
        "jsCode": "// misma autenticacion que los demas flujos: se compara hash\n// contra hash, nunca el token en claro.\nconst crypto = require('crypto');\n\nconst cabeceras = $input.first().json.headers || {};\nconst cuerpo    = $input.first().json.body    || {};\n\nconst token = cabeceras['x-sigac-token'] || '';\n\nconst tokenHash = token\n  ? crypto.createHash('sha256').update(token).digest('hex')\n  : 'sin-token';\n\n// solo se aceptan estos dos resultados de cierre\nconst resultado = ['atendida', 'ausente'].includes(cuerpo.resultado)\n  ? cuerpo.resultado\n  : null;\n\nreturn [{\n  json: {\n    token_hash: tokenHash,\n    id_cita: cuerpo.id_cita || 0,\n    resultado: resultado || 'invalido'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "86aebd94-91c0-456e-9b24-dd2e7763ab7b",
      "name": "Hash del token"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select rol from usuario_api where token_hash = $1 and activo = true;",
        "options": {
          "queryReplacement": "={{ $json.token_hash }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
