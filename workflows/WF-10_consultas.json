    {
      "parameters": {
        "jsCode": "// Agenda lista — WF-10 Consultas\n// Junta las citas del médico en una sola respuesta.\n// Si no hubo citas, Lee agenda entrega un elemento vacío: se descarta.\n\nconst fecha = $('Prepara agenda').first().json.fecha;\n\nconst citas = $input.all()\n  .map(item => item.json)\n  .filter(c => c.id_cita !== undefined && c.id_cita !== null)\n  .map(c => ({\n    id_cita: c.id_cita,\n    hora: c.hora,\n    estado: c.estado,\n    paciente: c.paciente,\n    tipo_consulta: c.tipo_consulta,\n    motivo: c.motivo,\n    tiene_nota: c.tiene_nota\n  }));\n\nreturn [{\n  json: {\n    codigo: 200,\n    estado: 'consultado',\n    fecha,\n    total: citas.length,\n    citas\n  }\n}];"
      },
