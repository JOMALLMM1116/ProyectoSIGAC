      "parameters": {
        "jsCode": "// Sesión válida — WF-10 Consultas\n// Devuelve solo lo que la pantalla necesita: rol, nombre y, si es médico,\n// su especialidad. Ningún identificador interno sale hacia la web.\n\nconst usuario = $('Identifica al usuario').first().json;\n\nconst respuesta = {\n  codigo: 200,\n  estado: 'autenticado',\n  rol: usuario.rol,\n  nombre: usuario.nombre\n};\n\nif (usuario.rol === 'medico') {\n  respuesta.especialidad = usuario.especialidad;\n}\n\nreturn [{ json: respuesta }];"
      },
