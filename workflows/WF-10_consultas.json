        "query": "select c.id as id_cita,\n       to_char(c.fecha_hora at time zone 'America/Guatemala', 'HH24:MI') as hora,\n       c.estado,\n       p.nombre || ' ' || p.apellido as paciente,\n       s.tipo_consulta,\n       s.motivo,\n       exists (select 1 from nota_clinica n where n.id_cita = c.id) as tiene_nota\nfrom cita c\njoin usuario_api u\n     on u.id_medico = c.id_medico\n    and u.token_hash = $1\n    and u.activo\njoin paciente p\n     on p.id = c.id_paciente\nleft join solicitud_cita s\n     on s.id = c.id_solicitud\nwhere (c.fecha_hora at time zone 'America/Guatemala')::date = $2::date\n  and c.estado <> 'cancelada'\norder by c.fecha_hora;",
