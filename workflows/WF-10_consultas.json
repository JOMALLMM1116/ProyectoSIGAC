      "parameters": {
        "jsCode": "// Hash del token — WF-10 Consultas\n// Calcula el SHA-256 del token recibido y normaliza la consulta pedida.\n// Nunca devuelve cadenas vacías: los parámetros de Postgres las descartan.\n\nconst crypto = require('crypto');\n\nconst entrada = $input.first().json;\nconst cabeceras = entrada.headers || {};\nconst cuerpo = entrada.body || {};\n\nconst token = String(cabeceras['x-sigac-token'] || '').trim();\n\nconst CONSULTAS = ['sesion', 'citas', 'lista_espera', 'agenda', 'personas'];\nconst consulta = CONSULTAS.includes(cuerpo.consulta) ? cuerpo.consulta : 'invalida';\n\nreturn [{\n  json: {\n    token_hash: token\n      ? crypto.createHash('sha256').update(token).digest('hex')\n      : 'sin-token',\n    consulta\n  }\n}];"
      },
