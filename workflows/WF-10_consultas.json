        "jsCode": "// Rechazo 400 — WF-10 Consultas\n// La consulta no es una de las cinco admitidas, o no vino en el cuerpo.\n\nreturn [{\n  json: {\n    codigo: 400,\n    estado: 'rechazado',\n    mensaje: 'Datos invalidos',\n    errores: ['consulta debe ser sesion, citas, lista_espera, agenda o personas']\n  }\n}];"
