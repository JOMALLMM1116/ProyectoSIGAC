    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select le.id as id_espera,\n       le.id_solicitud,\n       le.prioridad,\n       le.notificada,\n       to_char(le.creado_en at time zone 'America/Guatemala', 'YYYY-MM-DD HH24:MI') as en_espera_desde,\n       to_char(s.fecha_preferida, 'YYYY-MM-DD') as fecha_preferida,\n       s.franja_preferida,\n       s.especialidad_solicitada,\n       s.tipo_consulta,\n       p.nombre || ' ' || p.apellido as paciente\nfrom lista_espera le\njoin solicitud_cita s\n     on s.id = le.id_solicitud\njoin paciente p\n     on p.id = s.id_paciente\nwhere le.atendida = false\n  and s.estado = 'en_espera'\norder by s.fecha_preferida, le.prioridad, le.creado_en;",
        "options": {}
      },
