    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into bitacora_auditoria\n  (tabla_afectada, id_registro, accion, rol, datos_enmascarados, hash_anterior, hash_actual)\nselect\n  'usuario_api',\n  $1::int,\n  'select',\n  $2,\n  'inicio de sesion',\n  b.hash_actual,\n  encode(sha256((b.hash_actual || 'usuario_api' || $3)::bytea), 'hex')\nfrom bitacora_auditoria b\norder by b.id desc\nlimit 1\nreturning id, hash_actual;",
        "options": {
          "queryReplacement": "={{ $json.id_usuario }}, {{ $json.rol }}, {{ $json.id_usuario }}"
        }
      },
