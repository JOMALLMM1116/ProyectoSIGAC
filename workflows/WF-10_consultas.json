    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select 'medico' as tipo,\n       m.id,\n       m.nombre,\n       m.especialidad,\n       m.colegiado,\n       case when m.baja_en is not null then 'baja'\n            when m.activo then 'activo'\n            else 'inactivo' end as estado\nfrom medico m\n\nunion all\n\nselect 'recepcionista',\n       r.id,\n       r.nombre,\n       null::text,\n       null::text,\n       case when r.baja_en is not null then 'baja'\n            when r.activo then 'activo'\n            else 'inactivo' end\nfrom recepcionista r\n\nunion all\n\nselect 'paciente',\n       p.id,\n       p.nombre || ' ' || p.apellido,\n       null::text,\n       null::text,\n       case when p.baja_en is not null then 'baja'\n            when p.activo then 'activo'\n            else 'inactivo' end\nfrom paciente p\n\norder by tipo, id;",
        "options": {}
      },
