    {
      "parameters": {
        "jsCode": "// Espera lista — WF-10 Consultas\n// Junta las solicitudes en espera en una sola respuesta, en el orden\n// en que WF-04 repartiría los cupos liberados.\n// Si no hay nadie esperando, Lee lista de espera entrega un elemento vacío.\n\nconst espera = $input.all()\n  .map(item => item.json)\n  .filter(e => e.id_espera !== undefined && e.id_espera !== null)\n  .map(e => ({\n    id_espera: e.id_espera,\n    id_solicitud: e.id_solicitud,\n    paciente: e.paciente,\n    fecha_preferida: e.fecha_preferida,\n    franja_preferida: e.franja_preferida,\n    especialidad_solicitada: e.especialidad_solicitada,\n    tipo_consulta: e.tipo_consulta,\n    prioridad: e.prioridad,\n    en_espera_desde: e.en_espera_desde,\n    notificada: e.notificada\n  }));\n\nreturn [{\n  json: {\n    codigo: 200,\n    estado: 'consultado',\n    total: espera.length,\n    espera\n  }\n}];"
