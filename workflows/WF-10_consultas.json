        "jsCode": "// Citas listas — WF-10 Consultas\n// Junta las citas del día de todos los médicos en una sola respuesta.\n// Si no hubo citas, Lee citas entrega un elemento vacío: se descarta.\n\nconst fecha = $('Prepara citas').first().json.fecha;\n\nconst citas = $input.all()\n  .map(item => item.json)\n  .filter(c => c.id_cita !== undefined && c.id_cita !== null)\n  .map(c => ({\n    id_cita: c.id_cita,\n    hora: c.hora,\n    estado: c.estado,\n    notificada: c.notificada,\n    paciente: c.paciente,\n    medico: c.medico,\n    especialidad: c.especialidad,\n    tipo_consulta: c.tipo_consulta\n  }));\n\nreturn [{\n  json: {\n    codigo: 200,\n    estado: 'consultado',\n    fecha,\n    total: citas.length,\n    citas\n  }\n}];"
      },
