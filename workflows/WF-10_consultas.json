        "jsCode": "// Prepara citas — WF-10 Consultas\n// La fecha es opcional: sin fecha, hoy en hora de Guatemala.\n// Valida el formato y que la fecha exista en el calendario.\n\nconst cuerpo = $('Webhook').first().json.body || {};\nconst hoy = DateTime.now().setZone('America/Guatemala').toISODate();\n\nconst recibida = cuerpo.fecha;\nconst fecha = (recibida === undefined || recibida === null || String(recibida).trim() === '')\n  ? hoy\n  : String(recibida).trim();\n\nconst errores = [];\nconst partes = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(fecha);\n\nif (!partes) {\n  errores.push('fecha debe tener el formato AAAA-MM-DD');\n} else {\n  const anio = Number(partes[1]);\n  const mes = Number(partes[2]);\n  const dia = Number(partes[3]);\n  const d = new Date(Date.UTC(anio, mes - 1, dia));\n  if (d.getUTCFullYear() !== anio || d.getUTCMonth() !== mes - 1 || d.getUTCDate() !== dia) {\n    errores.push('fecha no existe en el calendario');\n  }\n}\n\nreturn [{\n  json: {\n    valida: errores.length === 0,\n    fecha: errores.length === 0 ? fecha : 'invalida',\n    errores\n  }\n}];"
