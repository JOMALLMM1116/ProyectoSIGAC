    {
      "parameters": {
        "jsCode": "// Personas listas — WF-10 Consultas\n// Separa médicos, recepcionistas y pacientes en tres listas.\n// Ningún dato cifrado ni de contacto: solo lo que el administrador\n// necesita para elegir a quién desactivar, dar de baja o reactivar.\n\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(f => f.id !== undefined && f.id !== null);\n\nconst medicos = filas\n  .filter(f => f.tipo === 'medico')\n  .map(f => ({\n    id: f.id,\n    nombre: f.nombre,\n    especialidad: f.especialidad,\n    colegiado: f.colegiado,\n    estado: f.estado\n  }));\n\nconst recepcionistas = filas\n  .filter(f => f.tipo === 'recepcionista')\n  .map(f => ({ id: f.id, nombre: f.nombre, estado: f.estado }));\n\nconst pacientes = filas\n  .filter(f => f.tipo === 'paciente')\n  .map(f => ({ id: f.id, nombre: f.nombre, estado: f.estado }));\n\nreturn [{\n  json: {\n    codigo: 200,\n    estado: 'consultado',\n    medicos,\n    recepcionistas,\n    pacientes\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
