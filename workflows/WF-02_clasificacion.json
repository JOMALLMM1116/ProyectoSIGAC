      "id": "0d055206-b32f-4609-b36e-548c7df445d5",
      "name": "¿Hay cupo?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with nueva as (\n  insert into cita (id_solicitud, id_paciente, id_medico, fecha_hora)\n  values (\n    {{ $('Calcula prioridad').item.json.id_solicitud }},\n    {{ $('Calcula prioridad').item.json.id_paciente }},\n    {{ $json.id_medico }},\n    (date '{{ $('Calcula prioridad').item.json.fecha_preferida }}' + time '{{ $json.hora_inicio }}')\n  )\n  returning id, id_solicitud\n)\nupdate solicitud_cita\nset estado = 'asignada',\n    prioridad = {{ $('Calcula prioridad').item.json.prioridad }}\nfrom nueva\nwhere solicitud_cita.id = nueva.id_solicitud\nreturning nueva.id as id_cita, solicitud_cita.id as id_solicitud, solicitud_cita.estado;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        560,
        -160
      ],
      "id": "e3b0a943-a8fc-4fcc-bf9c-7cec135d03c1",
      "name": "Crea cita",
      "retryOnFail": true,
      "credentials": {
        "postgres": {
          "id": "SboKk4ZMcKtMLxBt",
          "name": "SIGAC PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with espera as (\n  insert into lista_espera (id_solicitud, prioridad)\n  values (\n    {{ $('Calcula prioridad').item.json.id_solicitud }},\n    {{ $('Calcula prioridad').item.json.prioridad }}\n  )\n  on conflict (id_solicitud) do nothing\n  returning id, id_solicitud\n)\nupdate solicitud_cita\nset estado = 'en_espera',\n    prioridad = {{ $('Calcula prioridad').item.json.prioridad }}\nwhere id = {{ $('Calcula prioridad').item.json.id_solicitud }}\nreturning id as id_solicitud, estado, prioridad;",
        "options": {
          "queryBatching": "independently"
        }
      },
