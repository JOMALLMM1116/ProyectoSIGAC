      "name": "Clasifica consulta"
    },
    {
      "parameters": {
        "jsCode": "// la prioridad sale del tipo de consulta: 1 mayor urgencia, 5 menor.\n// el turno reparte los items del mismo lote en horarios distintos,\n// porque todos se evaluan antes de que se inserte ninguna cita.\nconst tipos = { urgencia: 1, control: 3, general: 5 };\n\nreturn $input.all().map((item, i) => ({\n  json: {\n    id_solicitud: item.json.id,\n    id_paciente: item.json.id_paciente,\n    tipo_consulta: item.json.tipo_consulta,\n    fecha_preferida: item.json.fecha_preferida,\n    prioridad: tipos[item.json.tipo_consulta] || 5,\n    turno: i\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        -80
      ],
      "id": "845d121d-d21f-480d-aad1-e305b3491912",
      "name": "Calcula prioridad"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select m.id as id_medico,\n       d.hora_inicio,\n       d.cupos,\n       (select count(*) from cita c\n        where c.id_medico = d.id_medico\n          and c.fecha_hora::date = date '{{ $json.fecha_preferida }}'\n          and c.estado = 'confirmada') as ocupados\nfrom disponibilidad d\njoin medico m on m.id = d.id_medico\nwhere m.activo = true\n  and d.dia_semana = extract(isodow from date '{{ $json.fecha_preferida }}')\norder by d.hora_inicio;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -144,
        -80
      ],
      "id": "568e53df-d81d-4458-b37c-07e3b554f19b",
      "name": "Busca cupo",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "SboKk4ZMcKtMLxBt",
          "name": "SIGAC PostgreSQL"
        }
      }
    },
    {
      "parameters": {
