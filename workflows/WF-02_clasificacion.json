      "name": "Clasifica consulta"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// la prioridad sale del tipo de consulta:\n// 1 es la mayor urgencia, 5 la menor.\nconst tipos = {\n  urgencia: 1,\n  control: 3,\n  general: 5\n};\n\nconst tipo = $json.tipo_consulta;\n\nreturn {\n  json: {\n    id_solicitud: $json.id,\n    id_paciente: $json.id_paciente,\n    tipo_consulta: tipo,\n    fecha_preferida: $json.fecha_preferida,\n    prioridad: tipos[tipo] || 5\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -64
      ],
      "id": "845d121d-d21f-480d-aad1-e305b3491912",
      "name": "Calcula prioridad"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select m.id as id_medico,\n       (d.hora_inicio + (interval '30 minutes' * (\n          select count(*) from cita c\n          where c.id_medico = d.id_medico\n            and c.fecha_hora::date = date '{{ $json.fecha_preferida }}'\n            and c.estado = 'confirmada'\n       ))) as hora_inicio,\n       d.cupos\nfrom disponibilidad d\njoin medico m on m.id = d.id_medico\nwhere m.activo = true\n  and d.dia_semana = extract(isodow from date '{{ $json.fecha_preferida }}')\n  and d.cupos > (\n    select count(*) from cita c\n    where c.id_medico = d.id_medico\n      and c.fecha_hora::date = date '{{ $json.fecha_preferida }}'\n      and c.estado = 'confirmada'\n  )\norder by d.hora_inicio\nlimit 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        112,
        -64
      ],
      "id": "568e53df-d81d-4458-b37c-07e3b554f19b",
      "name": "Busca cupo",
      "alwaysOutputData": true,
      "credentials": {
