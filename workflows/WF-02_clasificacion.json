      ],
      "id": "0d055206-b32f-4609-b36e-548c7df445d5",
      "name": "¿Hay cupo?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with nueva as (\n  insert into cita (id_solicitud, id_paciente, id_medico, fecha_hora)\n  values (\n    {{ $json.id_solicitud }},\n    {{ $json.id_paciente }},\n    {{ $json.id_medico }},\n    (date '{{ $json.fecha_preferida }}' + time '{{ $json.hora_inicio }}')\n  )\n  returning id, id_solicitud\n)\nupdate solicitud_cita\nset estado = 'asignada',\n    prioridad = {{ $json.prioridad }}\nfrom nueva\nwhere solicitud_cita.id = nueva.id_solicitud\nreturning nueva.id as id_cita, solicitud_cita.id as id_solicitud, solicitud_cita.estado;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        560,
        -160
      ],
      "id": "e3b0a943-a8fc-4fcc-bf9c-7cec135d03c1",
      "name": "Crea cita",
      "retryOnFail": true,
      "credentials": {
        "postgres": {
          "id": "SboKk4ZMcKtMLxBt",
          "name": "SIGAC PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with espera as (\n  insert into lista_espera (id_solicitud, prioridad)\n  values ({{ $json.id_solicitud }}, {{ $json.prioridad }})\n  on conflict (id_solicitud) do nothing\n  returning id, id_solicitud\n)\nupdate solicitud_cita\nset estado = 'en_espera',\n    prioridad = {{ $json.prioridad }}\nwhere id = {{ $json.id_solicitud }}\nreturning id as id_solicitud, estado, prioridad;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        560,
        32
      ],
      "id": "4b2cb222-1bc7-45f6-8bd7-bf7bf607d09d",
      "name": "Ingresa a lista de espera",
      "credentials": {
        "postgres": {
          "id": "SboKk4ZMcKtMLxBt",
          "name": "SIGAC PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        864,
        -64
      ],
      "id": "88745f48-3f19-4701-ace5-43bed86acfa2",
      "name": "Une resultados"
    },
    {
      "parameters": {
        "jsCode": "// Busca cupo devuelve las franjas repetidas una vez por cada solicitud\n// de entrada, asi que primero hay que quedarse con cada franja una vez.\nconst vistas = new Set();\nconst franjas = [];\n\nfor (const f of $('Busca cupo').all()) {\n  if (!f.json.id_medico) continue;\n  const clave = f.json.id_medico + '|' + f.json.hora_inicio;\n  if (vistas.has(clave)) continue;\n  vistas.add(clave);\n  franjas.push({\n    id_medico: f.json.id_medico,\n    hora_inicio: f.json.hora_inicio,\n    libres: Number(f.json.cupos) - Number(f.json.ocupados),\n    ocupados: Number(f.json.ocupados)\n  });\n}\n\n// reparte las solicitudes entre las franjas con cupo disponible.\n// se hace aqui y no en SQL porque todos los items se evaluan antes\n// de que se inserte ninguna cita: la base todavia no refleja las\n// asignaciones de este mismo lote.\nconst solicitudes = $('Calcula prioridad').all();\nconst salida = [];\n\nfor (const s of solicitudes) {\n  const franja = franjas.find(f => f.libres > 0);\n\n  if (franja) {\n    const [h, m] = franja.hora_inicio.split(':').map(Number);\n    const total = h * 60 + m + 30 * franja.ocupados;\n    const hora = String(Math.floor(total / 60)).padStart(2, '0') + ':' +\n                 String(total % 60).padStart(2, '0') + ':00';\n\n    franja.libres -= 1;\n    franja.ocupados += 1;\n\n    salida.push({ json: { ...s.json, id_medico: franja.id_medico, hora_inicio: hora } });\n  } else {\n    salida.push({ json: { ...s.json, id_medico: null, hora_inicio: null } });\n  }\n}\n\nreturn salida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        -80
      ],
      "id": "c661c6fb-3562-426a-928e-d076cadc45c8",
      "name": "Reparte cupos"
    }
