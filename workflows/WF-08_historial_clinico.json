    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select n.id, n.creado_en, m.nombre as medico, m.especialidad,\n       n.diagnostico_cifrado, n.indicaciones_cifrado\nfrom nota_clinica n\njoin medico m on m.id = n.id_medico\nwhere n.id_paciente = $1\norder by n.creado_en desc\nlimit 10;",
        "options": {
          "queryReplacement": "={{ $json.id_paciente }}"
        }
