    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into bitacora_auditoria\n  (tabla_afectada, id_registro, accion, rol, datos_enmascarados, hash_anterior, hash_actual)\nselect\n  'nota_clinica',\n  $1::int,\n  'insert',\n  'medico',\n  'cita ' || $2 || ' medico ' || $3,\n  b.hash_actual,\n  encode(sha256((b.hash_actual || 'nota_clinica' || $4)::bytea), 'hex')\nfrom bitacora_auditoria b\norder by b.id desc\nlimit 1\nreturning id, hash_actual;",
        "options": {
          "queryReplacement": "={{ $json.id }}, {{ $json.id_cita }}, {{ $json.id_medico }}, {{ $json.id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
