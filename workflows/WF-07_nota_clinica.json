      "id": "784e18f4-3f91-4ff5-898f-7d7af451b2e5",
      "name": "Registra bitácora",
      "credentials": {
        "postgres": {
          "id": "SboKk4ZMcKtMLxBt",
          "name": "SIGAC PostgreSQL"
        }
