    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select c.id as id_cita, c.id_paciente, e.id as id_expediente\nfrom cita c\njoin expediente e on e.id_cita = c.id\nwhere c.id = $1\n  and c.id_medico = $2\n  and (c.estado = 'atendida'\n       or (c.estado = 'confirmada' and c.fecha_hora <= now()));\n",
        "options": {
          "queryReplacement": "={{ $json.id_cita }}, {{ $json.id_medico }}"
        }
      },
